<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/webViewContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="52dp" android:layout_marginBottom="70dp" />
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_gravity="top" android:max="100" />
    <HorizontalScrollView android:id="@+id/windowTabScroller" android:layout_width="match_parent" android:layout_height="28dp" android:layout_gravity="top" android:layout_marginTop="8dp" android:fillViewport="false" android:scrollbars="none">
        <LinearLayout android:id="@+id/windowTabs" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center_vertical" android:orientation="horizontal" />
    </HorizontalScrollView>
    <LinearLayout android:id="@+id/actionDrawer" android:layout_width="wrap_content" android:layout_height="54dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp" android:background="@drawable/bg_action_bar" android:clipToPadding="false" android:elevation="4dp" android:gravity="center" android:orientation="horizontal">
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/menuButton" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:contentDescription="切换网站" android:elevation="0dp" android:padding="10dp" app:backgroundTint="@color/action_button_selected" app:fabSize="mini" app:srcCompat="@drawable/ic_sites" app:tint="@color/action_icon" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:contentDescription="返回" android:elevation="0dp" android:padding="10dp" app:backgroundTint="@color/action_button_selected" app:fabSize="mini" app:srcCompat="@drawable/ic_back" app:tint="@color/action_icon" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/windowButton" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:contentDescription="切换窗口" android:elevation="0dp" android:padding="10dp" app:backgroundTint="@color/action_button_selected" app:fabSize="mini" app:srcCompat="@drawable/ic_windows" app:tint="@color/action_icon" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/switchSiteButton" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:contentDescription="新建窗口" android:elevation="0dp" android:padding="10dp" app:backgroundTint="@color/action_button_selected" app:fabSize="mini" app:srcCompat="@drawable/ic_sites" app:tint="@color/action_icon" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/refreshButton" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:contentDescription="刷新" android:elevation="0dp" android:padding="10dp" app:backgroundTint="@color/action_button_selected" app:fabSize="mini" app:srcCompat="@drawable/ic_refresh" app:tint="@color/action_icon" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/clearCacheButton" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:contentDescription="清空网页缓存" android:elevation="0dp" android:padding="10dp" app:backgroundTint="@color/action_button_selected" app:fabSize="mini" app:srcCompat="@drawable/ic_cache" app:tint="@color/action_icon" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/clearLoginButton" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:layout_marginEnd="8dp" android:contentDescription="清除登录状态" android:elevation="0dp" android:padding="10dp" app:backgroundTint="@color/action_button_selected" app:fabSize="mini" app:srcCompat="@drawable/ic_login" app:tint="@color/action_icon" />
    </LinearLayout>
</FrameLayout>
